{
  "name": "praxis-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:https": "next dev --hostname 0.0.0.0 --port 3001 --experimental-https --experimental-https-key certificates/lan-key.pem --experimental-https-cert certificates/lan.pem",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "benchmark:grounding": "node --import tsx scripts/score-grounding.mts",
    "benchmark:replay": "node --import tsx scripts/replay-endpoints.ts",
    "benchmark:refine": "node --import tsx scripts/evaluate-refinement.mts",
    "build:cv": "node scripts/build-cv.mjs",
    "predev": "npm run build:cv",
    "predev:https": "npm run build:cv",
    "prebuild": "npm run build:cv"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
