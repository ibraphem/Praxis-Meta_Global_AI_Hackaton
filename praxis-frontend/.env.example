# Server-only. Never use NEXT_PUBLIC_ for these values.
PRAXIS_BACKEND_URL=http://127.0.0.1:3000
# If the backend requires a token, use its PRAXIS_API_TOKEN value here too.
PRAXIS_API_TOKEN=
# Keep this above the backend ANALYSIS_TIMEOUT_MS, allowing time for uploads.
PRAXIS_PROXY_TIMEOUT_MS=190000
