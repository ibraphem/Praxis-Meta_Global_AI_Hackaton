# Copy to server/.env. Never commit real credentials.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_SAM_MODEL=sam-3.1
META_REASONING_MODEL=muse-spark-1.3
# combined uses SAM locations + Muse interpretation. reasoning-only skips SAM.
VISION_MODE=combined
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Optional on loopback in development; required in production or on other hosts.
# Use a random token of at least 32 characters, distinct from META_API_KEY.
PRAXIS_API_TOKEN=
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=16000000
# Legacy synchronous analysis + endpoint admission (separate from the job queue).
MAX_CONCURRENT_ANALYSES=2
# Applies across job workers sharing this SQLite store; use the same value in each process.
JOB_WORKER_CONCURRENCY=1
# Shared local Muse admission across job interpretation, endpoint and verification requests.
MUSE_CONCURRENCY=2
SAM_CONCURRENCY=2
# Opt-in for NEW persisted analyses only. Existing analyses and legacy synchronous API are unchanged.
DYNAMIC_SCENE_ENABLED=false
# Each inventory/guided stage has its own deadline. Guided limits are cumulative per analysis.
SCENE_STAGE_TIMEOUT_MS=45000
SCENE_MAX_GUIDED_REQUESTS=3
SCENE_MAX_GUIDED_PIXELS=6000000
SCENE_MAX_CROP_PIXELS=2000000
# Optional single-batch wire refinement; 0 disables additional SAM calls.
MAX_WIRE_REFINEMENTS=6
REFINEMENT_TIMEOUT_MS=15000
# Local coverage audit: bounded HSV/contrast components and skeleton traces, no provider calls.
WIRE_AUDIT_MAX_DIMENSION=1280
# Explicit persisted crop recovery only; no automatic tile fan-out.
WIRE_RECOVERY_MAX_REQUESTS=4
WIRE_RECOVERY_REQUESTS_PER_ROUND=2
WIRE_RECOVERY_MAX_ROUNDS=2
WIRE_RECOVERY_MAX_PIXELS=6000000
WIRE_RECOVERY_MAX_CROP_PIXELS=2000000
WIRE_RECOVERY_TIMEOUT_MS=60000
# Lower-priority topology-uncertain continuation requests (charged within the same total limits).
WIRE_CONTINUATION_UNCERTAIN_MAX_REQUESTS=1
WIRE_VERIFY_MAX_REQUESTS=8
ANALYSIS_TIMEOUT_MS=180000
PROVIDER_TIMEOUT_MS=45000
# SAM transient retries only; Muse initial interpretation always uses one attempt.
PROVIDER_MAX_RETRIES=1
# Private SQLite job store; retain this directory on a persistent local volume.
ANALYSIS_JOB_DIR=.praxis-jobs
MAX_STORED_JOBS=100
JOB_RETENTION_HOURS=24
# For local benchmark sessions, 168 retains newly created jobs for seven days.
# Existing jobs keep their original expiration. Export evidence before it expires.
# 0 preserves current Muse input. Experimental alternatives: 1280 or 1024.
MUSE_MAX_DIMENSION=0
# Experimental: skip missed-wire search, retain board grouping and category checks.
MUSE_MINIMAL_PROMPT=false
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
