{
  "name": "praxis-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photograph-based component perception for Praxis",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write . ../README.md",
    "format:check": "prettier --check . ../README.md",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@meta-sam/parser": "^0.1.0",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
