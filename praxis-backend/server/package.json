{
  "name": "praxis-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Photograph-based component perception for Praxis",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "experiment:endpoints": "node --env-file-if-exists=.env --import tsx scripts/experiment-endpoints.ts",
    "experiment:muse": "node --env-file-if-exists=.env --import tsx scripts/experiment-muse.ts",
    "wire:audit": "node --import tsx scripts/audit-wires.ts",
    "wire:score": "node --import tsx scripts/score-wires.ts",
    "scene:score-targeting": "node --import tsx scripts/score-connector-targeting.ts",
    "scene:preview-targeting-v2": "node --env-file-if-exists=.env --import tsx scripts/preview-automatic-targeting-v2.ts",
    "scene:score": "node --import tsx scripts/score-scene.ts",
    "evidence:export": "node --env-file-if-exists=.env --import tsx scripts/export-evidence.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write . ../README.md",
    "format:check": "prettier --check . ../README.md",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "scene:freeze-truth": "node --import tsx scripts/freeze-scene-truth.ts",
    "scene:replay-identities": "node --import tsx scripts/replay-scene-identities.ts",
    "experiment:synthetic": "node --import tsx scripts/synthetic-connector-workflow.ts",
    "connector:reference": "node --env-file-if-exists=.env --import tsx scripts/connector-reference.ts",
    "experiment:automatic": "node --env-file-if-exists=.env --import tsx scripts/experiment-automatic.ts",
    "experiment:connector": "node --env-file-if-exists=.env --import tsx scripts/experiment-connector.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@meta-sam/parser": "^0.1.0",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
